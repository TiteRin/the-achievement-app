# --- Local development (npm run dev + docker-compose.yml) ---

# Host port docker-compose binds Postgres to. Change if 5432 is already
# taken on your machine, and update DATABASE_URL's port to match.
POSTGRES_PORT=5432

DATABASE_URL="postgresql://myachievements:myachievements@localhost:5432/myachievements"

# Generate with: openssl rand -base64 33
AUTH_SECRET=

# Comma-separated emails auto-promoted to admin on next login (see
# CLAUDE.md). Optional — leave unset to keep using the manual
# `UPDATE users SET role = 'admin' ...` process.
ADMIN_EMAILS=

# SMTP for magic-link sign-in emails. Optional — password login keeps
# working without it; magic-link requests just fail to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="The Achievement App <no-reply@example.com>"

# --- Self-hosted deployment only (docker-compose.prod.yml) ---
# Not used by `npm run dev`; only read by the prod compose file.

POSTGRES_USER=myachievements
POSTGRES_PASSWORD=
POSTGRES_DB=myachievements
# Host port the app is exposed on (put a reverse proxy in front of it).
APP_PORT=3000
